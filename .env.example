# =============================================================================
# HCZ Backend 环境变量模板
# 复制为 .env 并根据实际部署环境填写
# 警告：.env 包含敏感信息，已在 .gitignore 中排除，切勿提交到 Git
# =============================================================================

# -----------------------------------------------------------------------------
# 应用密钥（必填）
# 生产环境必须使用强随机字符串，建议 32+ 字符
# 也可通过 APP_KEY_FILE 指定密钥文件路径（文件必须位于项目目录之外）
# -----------------------------------------------------------------------------
APP_KEY=your-strong-random-app-key-here
CRON_SECRET=your-strong-random-cron-secret-here

# 调试模式：生产环境必须为 false
APP_DEBUG=false

# 应用域名（用于生成 URL）
APP_HOST=https://api.your-domain.com

# 域名绑定（可选），格式：域名:应用名,域名:应用名
# APP_DOMAIN_BIND=api.your-domain.com:index,admin.your-domain.com:index

# -----------------------------------------------------------------------------
# 数据库
# 注意：config/database.php 通过 env('DB_TYPE')/DB_HOST/DB_NAME/DB_USER/DB_PASS/
# DB_PORT/DB_CHARSET/DB_PREFIX 读取，必须使用下方 DB_* 平铺键。
# 旧的 [DATABASE] 段（TYPE/HOSTNAME/USERNAME/...）写法已被废弃，会导致
# DB_TYPE 为空、数据库无法连接（报 `Class "\think\db\builder\" not found`）。
# 更完整的部署模板请以 .example.env 为准。
# -----------------------------------------------------------------------------
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_NAME=hcz_production
DB_USER=hcz_user
DB_PASS=your-db-password
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_PREFIX=cz_

# -----------------------------------------------------------------------------
# Session Cookie 安全配置（RC-J）
#
# 这三项直接影响 Session Cookie 的安全性，生产环境必须正确配置。
#
# COOKIE_DOMAIN:
#   Cookie 所属域名。前后端同域时留空或填写主域；
#   跨子域时填写 .your-domain.com（注意前导点）。
#
# COOKIE_SECURE:
#   true  = Cookie 仅通过 HTTPS 传输（生产环境必须 true）
#   false = Cookie 可通过 HTTP 传输（仅开发环境使用）
#   注意：SameSite=None 必须配合 Secure=true，否则浏览器会拒绝 Cookie
#
# COOKIE_SAMESITE:
#   Lax  = 同域 GET 请求携带 Cookie，跨域 POST 不携带（推荐同域部署）
#   None = 跨域请求也携带 Cookie（必须同时设置 Secure=true，用于前后端跨域部署）
#   Strict = 完全禁止跨域携带（最严格，但可能影响正常跳转）
#   留空 = 不设置 SameSite 属性（依赖浏览器默认，通常为 Lax）
#
# 部署架构参考：
#   前后端同域（如 api.example.com + example.com/app）→ Secure=true, SameSite=Lax
#   前后端跨域（如 api.backend.com + frontend.com）  → Secure=true, SameSite=None
#   本地开发（HTTP）                                  → Secure=false, SameSite=Lax
# -----------------------------------------------------------------------------
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax

# -----------------------------------------------------------------------------
# 管理后台 IP 白名单
# 逗号分隔的 IP 或 CIDR，仅允许这些 IP 访问管理后台
# 生产环境务必限制为管理员实际出口 IP
# -----------------------------------------------------------------------------
ADMIN_IP_WHITELIST=127.0.0.1,管理员出口IP/32

# 可信代理 IP（用于解析真实客户端 IP）
# 仅当请求来自这些 IP 时，才会读取 X-Forwarded-For / CF-Connecting-IP 等头
ADMIN_TRUSTED_PROXY_IPS=127.0.0.1,::1

# 真实 IP 头优先级（从左到右）
ADMIN_REAL_IP_HEADERS=CF-Connecting-IP,X-Forwarded-For,X-Real-IP

# -----------------------------------------------------------------------------
# 子站 Host 识别（F9）
# 默认 false：不信任客户端提交的 X-Forwarded-Host，以实际 Host 识别子站。
# 仅当后端位于会强制覆盖该头的可信反代之后且客户端无法直连时才设为 true。
# -----------------------------------------------------------------------------
TRUST_PROXY_HEADERS=false

# -----------------------------------------------------------------------------
# 充值供应商凭据（F4/F5/F6）——占位模板，真实值由运营方在 .env 填写
# -----------------------------------------------------------------------------
# XIAOYUN_API_URL=https://ap.xiaoyun.top/api/xy/xhzw
# XIAOYUN_API_KEY=
# GFGGF_API_URL=http://api.gfggf.cn/api/gateway
# GFGGF_API_ID=
# GFGGF_API_KEY=
# TAOLALE_API_URL=https://api.taolale.com/api/Inquiry_Phone_Charges/get
# TAOLALE_API_KEY=
# TAOLALE_SIGN_SECRET=

# -----------------------------------------------------------------------------
# 缓存 / Redis（可选，Session 和限流优先使用 Redis）
# 不配置时回退到文件缓存
# -----------------------------------------------------------------------------
# [CACHE]
# TYPE=redis
# HOSTNAME=127.0.0.1
# HOSTPORT=6379
# PASSWORD=
# SELECT=0

# -----------------------------------------------------------------------------
# 支付配置（按需启用）
# -----------------------------------------------------------------------------
# BEPUSDT (USDT-TRC20)
# BEPUSDT_API_URL=https://api.bepusdt.com
# BEPUSDT_API_KEY=your-bepusdt-api-key

# 易支付
# EPAY_URL=https://pay.your-epay.com
# EPAY_PID=your-epay-pid
# EPAY_KEY=your-epay-key

# -----------------------------------------------------------------------------
# Telegram Bot（可选）
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_BOT_USERNAME=your_bot_username
