# ----------------------------------------------------------------------
# 应用基础配置
# 说明：
# 1. 生产环境建议关闭调试和追踪
# 2. 此文件为模板文件，不要填写真实敏感信息
# 3. 实际部署时请复制为 .env 后再填写真实值
# ----------------------------------------------------------------------
app_debug = false
app_trace = false
DEFAULT_LANG = zh-cn
# 2FA 密钥，必须使用真实值
DATA_ENCRYPTION_KEY=replace_with_your_own_64char_hex_key
# ----------------------------------------------------------------------
# 应用密钥 / 定时任务密钥
# 说明：
# 1. 可直接填写 APP_KEY / CRON_SECRET，或改为使用 *_FILE 指向仓库外安全文件
# 2. *_FILE 必须指向项目仓库外的可读文件
# 3. 下方仅为示例占位，请勿填写仓库内路径
# ----------------------------------------------------------------------
APP_KEY_FILE = /secure/path/app_key.txt
CRON_SECRET_FILE = /secure/path/cron_secret.txt

# ----------------------------------------------------------------------
# 域名绑定配置
# 说明：
# 1. 格式：域名=应用名，多个值使用英文逗号分隔
# 2. 这里只填写“直接访问 PHP 项目入口”的域名
# 3. 如果 H5 只是静态站并通过 Nginx 反代 /tp8api 到后端，可不写 H5 域名
# ----------------------------------------------------------------------
APP_DOMAIN_BIND = api.example.com:index,admin.example.com:index

# ----------------------------------------------------------------------
# 数据库配置
# 说明：
# 1. 生产环境必须使用独立数据库账号，不要使用 root
# 2. DB_PASS 必须设置为强密码
# 3. DB_CHARSET 建议保持 utf8 或按项目实际要求填写
# ----------------------------------------------------------------------
DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = your_database_name
DB_USER = your_database_user
DB_PASS = your_database_password
DB_PORT = 3306
DB_CHARSET = utf8
DB_PREFIX = cz_

# ----------------------------------------------------------------------
# Redis 配置
# 说明：
# 1. 如果 Redis 未设置密码，可留空
# 2. 生产环境建议开启密码和内网访问控制
# 3. 如果项目未实际使用 Redis，也建议保留配置项，避免环境不一致
# ----------------------------------------------------------------------
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD =

# ----------------------------------------------------------------------
# Cookie / Session 配置
# 说明：
# 1. 生产同站点部署（前后端同注册域/子域）推荐 SameSite=Lax（更安全）
# 2. 仅当后端与前端为「不同注册域」且需要跨站携带 Cookie 时，才使用 SameSite=None
#    ——必须同时配合 Secure=true，否则浏览器拒绝 Cookie
# 3. Secure=true 依赖 HTTPS，生产环境必须全站 HTTPS
# 4. 单主域方案下，后端统一固定为 xx.xxx.com
# 5. hcz.app 是前端域名，不是后端 Session 所属域
# 6. F14：config/session.php 已提供安全默认值（Lax / secure=false），
#    生产 HTTPS 必须显式设置 COOKIE_SECURE=true
# ----------------------------------------------------------------------
COOKIE_DOMAIN = xx.xxx.com
COOKIE_SAMESITE = Lax
COOKIE_SECURE = true

# ----------------------------------------------------------------------
# 队列配置
# 说明：
# 1. 开发环境可使用 sync，同步执行任务
# 2. 生产环境如启用 Telegram 批量查询，建议使用 redis
# 3. 使用 redis 时，必须启动消费者，例如：
#    php think queue:work --queue default,batchPhoneQuery,batchElectricityQuery
# 4. 如果需要记录失败任务，可将 QUEUE_FAILED_DRIVER 改为 database
# ----------------------------------------------------------------------
QUEUE_CONNECTION = sync
QUEUE_NAME = default
QUEUE_TABLE = jobs
QUEUE_DB_CONNECTION =
QUEUE_REDIS_HOST = 127.0.0.1
QUEUE_REDIS_PORT = 6379
QUEUE_REDIS_PASSWORD =
QUEUE_REDIS_DB = 0
QUEUE_REDIS_TIMEOUT = 0
QUEUE_REDIS_PERSISTENT = false
QUEUE_FAILED_DRIVER = none
QUEUE_FAILED_TABLE = failed_jobs

# ----------------------------------------------------------------------
# BEpusdt 配置
# 说明：
# 1. notify_url 必须指向后端公网回调地址
# 2. redirect_url 建议指向前端充值页面
# 3. 实际入账以后端 notify 异步回调为准
# ----------------------------------------------------------------------
BEPUSDT_ENABLED = false
BEPUSDT_BASE_URL = https://your-bepusdt-domain
BEPUSDT_API_TOKEN =
BEPUSDT_NOTIFY_URL = https://api.your-domain.com/api/callback/bepusdt
EPAY_NOTIFY_URL = https://api.your-domain.com/epay_notify_url
BEPUSDT_REDIRECT_URL = https://your-frontend-domain.com/profile
BEPUSDT_TRADE_TYPE = usdt.bsc
BEPUSDT_FIAT = CNY

# ----------------------------------------------------------------------
# Telegram / 第三方接口配置
# 说明：
# 1. 生产、测试、开发环境必须使用不同 token、secret、API key、管理员 ID
# 2. 不要把真实 token、secret、API key 提交到仓库
# 3. TELEGRAM_WEBHOOK_URL 必须与 route/app.php 中真实路由一致
# 4. 当前代码真实 webhook 路由为：/robot/webhook
# ----------------------------------------------------------------------
TELEGRAM_ENV = production

# Telegram 机器人凭证
TELEGRAM_BOT_TOKEN = replace_me
TELEGRAM_WEBHOOK_URL = https://your-domain/robot/webhook
TELEGRAM_WEBHOOK_SECRET = replace_me

# 代理配置
# 说明：如服务器访问 Telegram 需要代理，可填写代理地址；不需要则留空
TELEGRAM_PROXY =

# Telegram 消息中使用的网站地址
# 说明：
# 1. TELEGRAM_WEBSITE_URL 用于生成绑定链接或站内跳转链接
# 2. TELEGRAM_OFFICIAL_WEBSITE 用于展示官方站点信息
# 3. TELEGRAM_BOT_USERNAME 为绑定页/机器人入口使用的机器人用户名，不带 @
# 4. TELEGRAM_SUPPORT_USERNAME 为客服用户名，不带 @
TELEGRAM_WEBSITE_URL = https://your-domain
TELEGRAM_OFFICIAL_WEBSITE = https://your-official-site
TELEGRAM_BOT_USERNAME = your_bot_username
TELEGRAM_SUPPORT_USERNAME = your_support_bot

# 第三方接口凭证
# 说明：
# 1. 以下 URL 通常为服务商固定地址
# 2. CKEY 为供应商下发密钥，必须使用真实值
# 3. 上线前建议确认额度、白名单、调用频率限制
PHONE_BILL_API_URL = https://api.xleyou.com/api/huafei/get_zonghe
PHONE_BILL_API_CKEY = replace_me
ELECTRICITY_BILL_API_URL = https://api.xleyou.com/api/dianfei/get_dfcx
ELECTRICITY_BILL_API_CKEY = replace_me

# ----------------------------------------------------------------------
# 充值供应商凭据（F4/F5/F6）——真实值由运营方在 .env 填写，禁止提交到仓库
# 说明：
# 1. 历史版本曾把真实 Key 硬编码进源码并进入 Git 历史，必须在供应商侧轮换密钥
# 2. xiaoyun（号码归属地查询）、gfggf（号码余额，当前无调用方=死代码）、
#    taolale（号码余额查询）
# 3. gfggf 默认端点为 http://（明文），HTTPS 端点需向服务商确认后覆盖 GFGGF_API_URL；
#    未确认前不猜测、不伪造 https 端点
# 4. taolale 正式签名规范/真实 Secret 需向服务商确认后填写 TAOLALE_SIGN_SECRET
# ----------------------------------------------------------------------
XIAOYUN_API_URL = https://ap.xiaoyun.top/api/xy/xhzw
XIAOYUN_API_KEY =
GFGGF_API_URL = http://api.gfggf.cn/api/gateway
GFGGF_API_ID =
GFGGF_API_KEY =
TAOLALE_API_URL = https://api.taolale.com/api/Inquiry_Phone_Charges/get
TAOLALE_API_KEY =
TAOLALE_SIGN_SECRET =

# ----------------------------------------------------------------------
# 可信代理头（F9）
# 说明：
# 1. 默认 false：后端以实际 Host 识别子站，不信任客户端提交的 X-Forwarded-Host
# 2. 仅当后端位于「会强制覆盖 X-Forwarded-Host 的可信反代/Nginx」之后、
#    且客户端无法直连后端时，才设为 true
# ----------------------------------------------------------------------
TRUST_PROXY_HEADERS = false

# Telegram 群组 / 管理员 ID
# 说明：
# 1. 多个值使用英文逗号分隔
# 2. 群组 ID 一般为负数
# 3. 管理员 ID 建议只保留当前实际维护人员
TELEGRAM_OFFICIAL_GROUP_IDS = -1000000000000,-1000000000001
TELEGRAM_ADMIN_USER_IDS = 123456789,987654321
